<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Sends all accounts whos &quot;Other Address&quot; is no longer valid to Billecta with current Address information</description>
    <environments>Default</environments>
    <interviewLabel>Account - Scheduled - Send new Current Address to Billecta {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Scheduled - Send new Current Address to Billecta</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_date_to_send_to_billecta</name>
        <label>Set date to send to billecta</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <inputAssignments>
            <field>BillectaMarkedForUpdate__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_date_to_send_to_billecta</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4)</filterLogic>
        <filters>
            <field>OtherAddressEndDateWasYesterday__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>MembershipStatus__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Aktiv</stringValue>
            </value>
        </filters>
        <filters>
            <field>MembershipStatus__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Kommande</stringValue>
            </value>
        </filters>
        <filters>
            <field>MembershipStatus__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Begärt utträde</stringValue>
            </value>
        </filters>
        <object>Account</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2022-02-15</startDate>
            <startTime>15:20:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
