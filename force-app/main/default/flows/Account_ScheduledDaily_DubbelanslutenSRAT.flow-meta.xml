<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>2025-07-02: Now Dubbelansluten SRAT members shoudl always have the checkbox: &quot;Postal Pappersfaktura&quot; marked as true
2025-05-16: Don&apos;t wiping bank details from account fields in here any more. This is now handled from Account before save trigger instead.
Uppdaterar betalmetod och distributionssätt för medlemmar med avgiftsklass Dubbelansluten SRAT</description>
    <environments>Default</environments>
    <interviewLabel>Account_ScheduledDaily_DubbelanslutenSRAT - {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Scheduled Daily - FeeCat: Dubbelansluten SRAT</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Sätt BG + Postalt.
Andra fält med bank-detaljer rensas av Accountr before save triggered flow.</description>
        <name>Set_payment_details</name>
        <label>Set payment details</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>DistributionMethod__c</field>
            <value>
                <stringValue>Post</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsDistributionPostalPaperOnly__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PaymentMethod__c</field>
            <value>
                <stringValue>BG</stringValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_payment_details</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4) AND (5 OR 6)</filterLogic>
        <filters>
            <field>FeeCategory__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Dubbelansluten SRAT</stringValue>
            </value>
        </filters>
        <filters>
            <field>MembershipStatus__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Aktiv</stringValue>
            </value>
        </filters>
        <filters>
            <field>MembershipStatus__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Kommande</stringValue>
            </value>
        </filters>
        <filters>
            <field>MembershipStatus__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Begärt utträde</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsDistributionPostalPaperOnly__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>DistributionMethod__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Post</stringValue>
            </value>
        </filters>
        <object>Account</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-03-25</startDate>
            <startTime>22:30:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
