<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>CHECK_OtherActiveMainAgreementConnectionExist</name>
        <label>Other Active Main Agreement Connection Exist?</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <defaultConnector>
            <targetReference>UPDATE_ClearCurrentMainAgreementEmployer</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>CHECK_OtherActiveMainAgreementConnectionExist_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GET_OtherActiveMainAgreementConnection</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UPDATE_SetCurrentMainAgreementEmployer</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Clears or updates CurrentMainAgreementEmployer on Employer Accounts when Agreement Connection is deleted</description>
    <environments>Default</environments>
    <interviewLabel>Agreement Connection - Trigger - After Delete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Agreement Connection - Trigger - After Delete</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GET_OtherActiveMainAgreementConnection</name>
        <label>Get other active Main Agreement Connection</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>CHECK_OtherActiveMainAgreementConnectionExist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BusinessAccount__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.BusinessAccount__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Aktiv</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsMainAgreement__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AgreementConnection__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Clears CurrentMainAgreementEmployer on Business Account</description>
        <name>UPDATE_ClearCurrentMainAgreementEmployer</name>
        <label>Clear Current Main Agreement Employer on Business Account</label>
        <locationX>314</locationX>
        <locationY>503</locationY>
        <inputAssignments>
            <field>CurrentMainAgreementEmployer__c</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.BusinessAccount__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Sets Agreement from &quot;other active Main Agreement Connection&quot; on Business Account</description>
        <name>UPDATE_SetCurrentMainAgreementEmployer</name>
        <label>Set Current Main Agreement Employer on Account</label>
        <locationX>50</locationX>
        <locationY>503</locationY>
        <inputAssignments>
            <field>CurrentMainAgreementEmployer__c</field>
            <value>
                <elementReference>GET_OtherActiveMainAgreementConnection.Agreement__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.BusinessAccount__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GET_OtherActiveMainAgreementConnection</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsMainAgreement__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Aktiv</stringValue>
            </value>
        </filters>
        <object>AgreementConnection__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
</Flow>
