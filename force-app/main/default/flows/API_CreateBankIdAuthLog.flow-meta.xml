            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Input__c</field>
            <value>
                <stringValue>Pnr: {!pnr} Status: {!status}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Message__c</field>
            <value>
                <stringValue>Validation error: {!errorMsg}</stringValue>
