        <inputAssignments>
            <field>Type__c</field>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <object>DebugLog__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_debugLog2</name>
        <label>Create debugLog</label>
        <locationX>314</locationX>
        <locationY>566</locationY>
        <inputAssignments>
            <field>ExtraMessage__c</field>
            <value>
                <stringValue>Telia Ace Integration</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Flow_Name__c</field>
            <value>
                <stringValue>API_CreateBankIdAuthLog</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Flow_log__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Input__c</field>
            <value>
                <stringValue>Pnr: {!pnr} Status: {!status}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Message__c</field>
            <value>
                <stringValue>Error: {!$Flow.FaultMessage}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type__c</field>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <object>DebugLog__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Member</name>
        <label>Get Member</label>
        <locationX>314</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Member_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SocialSecurityNumber__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ssn_withoutDash</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>SocialSecurityNumber__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>452</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Validate_input</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>The error message to return in case of errors</description>
        <name>errorMsg</name>
        <dataType>String</dataType>
