    <decisions>
        <name>DEC_Active_Memberbenefit_Psykisk_ohalsa</name>
        <label>DEC Active Memberbenefit Psykisk ohälsa</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_active_Skandia_PO</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Membership_Benefit</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_MemberBenefit_Psykisk_oh_lsa</targetReference>
            </connector>
            <label>Yes, active Skandia PO</label>
        </rules>
    </decisions>
    <decisions>
        <name>DEC_GraduationDateFuture</name>
        <label>DEC Is graduation date in the future?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Date in the past</defaultConnectorLabel>
        <rules>
            <name>Yes_date_is_in_the_future</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Examensdatum</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>GraduationDate120Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.AutoGraduationDate__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>GraduationDate120Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.GraduationYear__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>$Record.GraduationSemester__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Get_Benefits</targetReference>
            </connector>
            <label>Yes, date is in the future</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Examensdatum</name>
        <dataType>Date</dataType>
        <expression>IF(TEXT({!$Record.GraduationSemester__c}) =  &quot;VT&quot;, 
DATE(VALUE({!$Record.GraduationYear__c}), 9, 1), 
DATE(VALUE({!$Record.GraduationYear__c}) + 1, 2, 1))</expression>
    </formulas>
    <formulas>
        <name>GraduationDate120Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 120</expression>
    </formulas>
    <interviewLabel>Account - Trigger - After Update - End SHPO After Exten {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Trigger - After Update - End SHPO After Postponent Of GraduationDate</label>
