    <decisions>
        <description>If person account is of type &apos;Förtroendevald, ej Akavia&apos; the account should only get the GDPRStatus__c stamp (needs it to be processed in next gdpr step after 1 year) and then flow ends.</description>
        <name>Check_account_type</name>
        <label>Check account type</label>
        <locationX>336</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Update_Account_Data</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Is &apos;Förtroendevald, ej Akavia&apos;</defaultConnectorLabel>
        <rules>
            <name>Is_not_F_rtroendevald_ej_Akavia</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Record.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Förtroendevald, ej Akavia</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Empty_Current_Employer</targetReference>
            </connector>
            <label>Is not &apos;Förtroendevald, ej Akavia&apos;</label>
        </rules>
    </decisions>
    <decisions>
        <name>CHECK_Found_Appointments</name>
        <label>CHECK - Found Appointments?</label>
        <locationX>182</locationX>
        <locationY>974</locationY>
        <defaultConnector>
            <targetReference>Set_Person_Account_Data</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CHECK_Found_Appointments_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GET_Appointments</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DELETE_Appointments</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_There_Employments_To_Delete</name>
        <label>Is There Employments To Delete</label>
        <locationX>182</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>GET_Appointments</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Employments To Delete</defaultConnectorLabel>
        <rules>
            <name>Yes_Employements_To_Delete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Employments_To_Delete</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Employment_Records</targetReference>
            </connector>
            <label>Yes, Employements To Delete</label>
        </rules>
    </decisions>
