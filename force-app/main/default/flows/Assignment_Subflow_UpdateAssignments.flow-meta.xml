<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>CHECK_AF</name>
        <label>Assignments Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Assignment Found</defaultConnectorLabel>
        <rules>
            <name>CHECK_AF_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GET_AllActiveAssigmentsToEnd</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>TRANSFORM_AddEndDateToAssigmentsToEnd</targetReference>
            </connector>
            <label>Yes, Assigments found</label>
        </rules>
    </decisions>
    <decisions>
        <name>CHECK_NEM</name>
        <label>New Employer / Manager</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>None of the above</defaultConnectorLabel>
        <rules>
            <name>CHECK_NE_Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>var_sObj_CurrentEmployment.Workplace__r.ParentId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>var_sObj_PreviousEmployment.Workplace__r.ParentId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_sObj_CurrentEmployment.Manager__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GET_AllActiveAssigmentsToEnd</targetReference>
            </connector>
            <label>Yes, New Employer And Manager</label>
        </rules>
    </decisions>
    <description>This subflow is launched from record triggered flow employment (EmploymentAfterCreate) to update / end assignments based on what the new employment is. ORIGIN: AST-213 https://dev.azure.com/AkaviaStretch/AkaviaStretch/_boards/board/t/AkaviaStretch%20Team/Stories?workitem=213</description>
    <environments>Default</environments>
    <interviewLabel>Assignment -Subflow- Update Assignments {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Assignment -Subflow- Update Assignments</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GET_AllActiveAssigmentsToEnd</name>
        <label>Get All Active Assigments To End</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>CHECK_AF</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Person__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_T_PersonAccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Lokalt Förtroendevald</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Aktiv</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Assignment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GET_PreviousEmployment</name>
        <label>Get Previous Employment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>CHECK_NEM</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Person__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_T_PersonAccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>EndDate__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Employment__c</object>
        <outputReference>var_sObj_PreviousEmployment</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Workplace__c</queriedFields>
        <sortField>EndDate__c</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordUpdates>
        <name>UPDATE_ActiveAssignments</name>
        <label>Update Active Assignments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>TRANSFORM_AddEndDateToAssigmentsToEnd</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GET_PreviousEmployment</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <transforms>
        <name>TRANSFORM_AddEndDateToAssigmentsToEnd</name>
        <label>Add End Date To Assigments To End</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>UPDATE_ActiveAssignments</targetReference>
        </connector>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <objectType>Assignment__c</objectType>
        <scale>0</scale>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <outputFieldApiName>Id</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>GET_AllActiveAssigmentsToEnd[$EachItem].Id</elementReference>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>EndDate__c</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
