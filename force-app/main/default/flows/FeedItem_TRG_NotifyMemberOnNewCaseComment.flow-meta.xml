    <decisions>
        <name>CHECK_Add_CoOwner_To_Recipients</name>
        <label>CHECK: Add CoOwner To Recipients?</label>
        <locationX>446</locationX>
        <locationY>1379</locationY>
        <defaultConnector>
            <targetReference>Send_Custom_Notification_Action_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_AddCoOwner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent:Case.CoOwner__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent:Case.CoOwner__r.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent:Case.CoOwner__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Parent:Case.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_CoOwner_To_Recipients</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
