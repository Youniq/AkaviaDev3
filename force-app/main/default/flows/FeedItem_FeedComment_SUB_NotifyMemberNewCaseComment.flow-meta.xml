    <decisions>
        <description>Checks if comment creator has profile Akavia Förhandling or Akavia Medlemsservice</description>
        <name>CHECK_FeedCommentQualifiedForEmailAlert</name>
        <label>Feed Comment qualified for Email Alert to Member?</label>
        <locationX>644</locationX>
        <locationY>542</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>CHECK_FeedCommentQualifiedForEmailAlert_Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>var_sObj_FeedComment.CreatedBy.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Akavia Förhandling</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_sObj_FeedComment.CreatedBy.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Akavia Medlemsservice</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GET_ParentFeedItem</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if input parameter is a Feed Item or a Feed Comment</description>
        <name>CHECK_FeedItemOrFeedComment</name>
        <label>Feed Item or Feed Comment?</label>
        <locationX>578</locationX>
        <locationY>434</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CHECK_FeedItemOrFeedComment_FeedItem</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_sObj_FeedItem</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ASSIGN_CaseInfoFromFeedItem</targetReference>
            </connector>
            <label>Feed Item</label>
        </rules>
        <rules>
            <name>CHECK_FeedItemOrFeedComment_FeedComment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_sObj_FeedComment</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CHECK_FeedCommentQualifiedForEmailAlert</targetReference>
            </connector>
            <label>Feed Comment</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if parent Case is not Arbetsgivarärende and Created by User = Case Account User</description>
        <name>CHECK_FeedItemQualifiedForEmailAlertToMember</name>
        <label>Feed Item qualified for email alert to Member?</label>
        <locationX>446</locationX>
        <locationY>758</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>CHECK_NewCommentAdded_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GET_ParentFeedItem.Parent:Case.Reason</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Arbetsgivarärende</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GET_ParentFeedItem.CreatedBy:User.Account.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>GET_ParentFeedItem.Parent:Case.Account.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SET_CaseInfoFromFeedComment</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
