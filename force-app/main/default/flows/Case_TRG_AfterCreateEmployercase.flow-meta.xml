    </decisions>
    <description>2025-12-29: New flow to trigger mail when new employer case is created.</description>
    <environments>Default</environments>
    <formulas>
        <description>Matchar fälten som AG fyller i i förhandingsframställan på akavia.se. Formeln nyttjas för att kunna skicka olika mail baserat på valt alternativ.</description>
        <name>CaseSpecialFields</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  TEXT($Record.OtherParties__c) == &quot;Ja&quot;,
  TEXT($Record.AkaviaOrSacoMember__c) == &quot;Ja&quot;,
  TEXT($Record.SendAttachments__c) == &quot;Ja&quot;
)</expression>
    </formulas>
