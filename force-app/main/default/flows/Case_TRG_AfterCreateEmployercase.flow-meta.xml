        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_SpecialFieldsEmployer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CaseSpecialFields</leftValueReference>
