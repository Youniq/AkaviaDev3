    <description>Sätter status godkänd och dagens datum som godkännande datum</description>
    <environments>Default</environments>
    <formulas>
        <name>UserFriendlyError</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!$Flow.FaultMessage}, &apos;FIELD_CUSTOM_VALIDATION_EXCEPTION:&apos;),
LEFT(
RIGHT({!$Flow.FaultMessage},
LEN({!$Flow.FaultMessage})-(FIND(&apos;FIELD_CUSTOM_VALIDATION_EXCEPTION:&apos;, {!$Flow.FaultMessage}))-LEN(&apos;FIELD_CUSTOM_VALIDATION_EXCEPTION:&apos;)),
FIND(&apos;You can look up ExceptionCode&apos;, RIGHT({!$Flow.FaultMessage},
LEN({!$Flow.FaultMessage})-(FIND(&apos;FIELD_CUSTOM_VALIDATION_EXCEPTION:&apos;, {!$Flow.FaultMessage}))-LEN(&apos;FIELD_CUSTOM_VALIDATION_EXCEPTION:&apos;)))-1)
 

,null)</expression>
    </formulas>
