    <formulas>
        <name>AliasCreator</name>
        <dataType>String</dataType>
        <expression>LEFT(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!PersonAccountRecord.FirstName}, &quot;å&quot;, &quot;a&quot;),&quot;ä&quot;, &quot;a&quot;),&quot;ö&quot;, &quot;o&quot;),3) &amp; LEFT(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!PersonAccountRecord.LastName}, &quot;å&quot;, &quot;a&quot;),&quot;ä&quot;, &quot;a&quot;),&quot;ö&quot;, &quot;o&quot;),3)</expression>
    </formulas>
    <formulas>
        <name>EmailCreatorNoEmail</name>
        <dataType>String</dataType>
        <expression>{!PersonAccountRecord.MemberNumber__c} &amp; &quot;@&quot; &amp; {!GET_CommunityUsernameSuffix.Text__c}</expression>
    </formulas>
    <formulas>
        <name>NickNameCreator</name>
