    </formulas>
    <formulas>
        <name>UserNameCreator</name>
        <dataType>String</dataType>
        <expression>{!PersonAccountRecord.PersonEmail} &amp; &quot;.&quot; &amp; {!PersonAccountRecord.MemberNumber__c} &amp; {!GET_CommunityUsernameSuffix.Text__c}</expression>
    </formulas>
