<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Har personen aktiva uppdrag, eller avslutat sina uppdrag?</description>
        <name>CHECK_CountActiveFortroendeuppdragChanged</name>
        <label>Has Aktivt förtroendeuppdrag Changed</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Standardresultat</defaultConnectorLabel>
        <rules>
            <name>Yes_CHECH_CountActiveFortroendeuppdragChange</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.HasActiveFortroendeuppdrag__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SET_DateValue_for_DateChangeHasActiveFortroendeuppdrag</targetReference>
            </connector>
            <label>Has Changed</label>
        </rules>
    </decisions>
    <description>2024-07-04: Flow created to set date when Aktiv förtroendeuppdrag is changed från true/false or false/true</description>
    <environments>Default</environments>
    <interviewLabel>Account - Trigger - After Update - Assignment true/false {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Trigger - After Update - Assignment true/false</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
