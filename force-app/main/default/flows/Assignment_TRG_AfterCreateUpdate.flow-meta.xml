<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>SET_SyncWithMC</name>
        <label>Set Sync With MC</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <assignmentItems>
            <assignToReference>$Record.SyncWithMc__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>UPDATE_Assignment</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>CHECK_AssInfoNeedsUpdateCreated</name>
        <label>Assignemnt Info needs update?</label>
        <locationX>182</locationX>
        <locationY>947</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesStartDate_CHECK_AssInfoNeedsUpdateCreated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StartDate__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CHECK_FortroendevaldOrStudentmarknadsforare</targetReference>
            </connector>
            <label>Yes, start date &lt;= TODAY</label>
        </rules>
        <rules>
            <name>YesEndDate_CHECK_AssInfoNeedsUpdateCreated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EndDate__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CHECK_FortroendevaldOrStudentmarknadsforare</targetReference>
            </connector>
            <label>Yes, end date &lt; TODAY</label>
        </rules>
    </decisions>
    <decisions>
        <name>CHECK_AssInfoNeedsUpdateUpdated</name>
        <label>Assignment info needs update?</label>
        <locationX>886</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesStartDate_CHECK_AssInfoNeedsUpdateUpdated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StartDate__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StartDate__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.StartDate__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CHECK_FortroendevaldOrStudentmarknadsforare</targetReference>
            </connector>
            <label>Yes, start date &lt;= TODAY</label>
        </rules>
        <rules>
            <name>YesEndDate_CHECK_AssInfoNeedsUpdateUpdated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EndDate__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EndDate__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.EndDate__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CHECK_FortroendevaldOrStudentmarknadsforare</targetReference>
            </connector>
            <label>Yes, end date &lt; TODAY</label>
        </rules>
        <rules>
            <name>YesReopened_CHECK_AssInfoNeedsUpdateUpdated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.EndDate__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EndDate__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CHECK_FortroendevaldOrStudentmarknadsforare</targetReference>
            </connector>
            <label>Yes, assignment reopened</label>
        </rules>
    </decisions>
    <decisions>
        <name>CHECK_CreatedOrUpdated</name>
        <label>Created or Updated?</label>
        <locationX>534</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>CHECK_AssInfoNeedsUpdateUpdated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Updated</defaultConnectorLabel>
        <rules>
            <name>Created_CHECK_CreatedOrUpdated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CHECK_SyncWithMc</targetReference>
            </connector>
            <label>Created</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks:
Was start or end date set to yesterday or earlier?
Is assignment Lokalt förtroendevald or Centralt förtroendevald or Studentmarknadsförare?</description>
        <name>CHECK_FortroendevaldOrStudentmarknadsforare</name>
        <label>Uppdrag Förtroendevald eller Studentmarknadsförare?</label>
        <locationX>534</locationX>
        <locationY>1331</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_CHECK_FortroendevaldOrStudentmarknadsforare</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lokalt Förtroendevald</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Centralt Förtroendevald</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Role__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Studentmarknadsförare</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SUB_SetAssignmentInfoOnAccount</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if formula checkbox MCSynkValidator__c is true</description>
        <name>CHECK_SyncWithMc</name>
        <label>Sync with MC?</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>CHECK_AssInfoNeedsUpdateCreated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CHECK_SyncWithMc_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.MC_validator__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SET_SyncWithMC</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>* Update MC fields - 2026-08-14
* Updated to set SyncWithMc__c checkbox after create if MC_validator__c = true	
* Lagt till scenario för återöppnade Uppdrag</description>
