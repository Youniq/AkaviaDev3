        </connector>
        <inputAssignments>
            <field>AssignmentPlacementText_MC__c</field>
            <value>
                <elementReference>$Record.AssignmentPlacementText__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status_MC__c</field>
            <value>
                <elementReference>$Record.Status__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
