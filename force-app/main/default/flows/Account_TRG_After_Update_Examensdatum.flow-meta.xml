    <decisions>
        <name>CHECK_AutogradutionFuture</name>
        <label>DEC Is Autograduationdate in the future?</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>No, Autograduationdate is in the past</defaultConnectorLabel>
        <rules>
            <name>CHECK_YES_AutograduationdateFuture</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AutoGraduationDate__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>form_D_today</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Case</targetReference>
            </connector>
            <label>Yes, Autograduatondate future</label>
        </rules>
    </decisions>
    <description>2024-10-09: Updated with description in emailbody</description>
