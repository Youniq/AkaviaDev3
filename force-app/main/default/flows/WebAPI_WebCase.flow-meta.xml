    <formulas>
        <name>var_f_CaseSubjectOrganization</name>
        <dataType>String</dataType>
        <expression>&apos;Förhandlingsframställan -&apos; &amp; IF({!organizationName}!=&apos;&apos;,{!organizationName}, {!organizationNumber})</expression>
    </formulas>
    <formulas>
        <name>var_f_ErrorMessageInputText</name>
        <dataType>String</dataType>
        <expression>&apos;Input Parameters:  &apos;&amp;
IF(!ISBLANK({!name}), BR()&amp;&apos;Name: &apos; &amp; {!name},&apos;&apos;) &amp;
IF(!ISBLANK({!email}), BR()&amp;&apos;Email: &apos; &amp; {!email},&apos;&apos;) &amp;
IF(!ISBLANK({!phone}), BR()&amp;&apos;Phone: &apos; &amp; {!phone},&apos;&apos;) &amp;
IF(!ISBLANK({!category}), BR()&amp;&apos;Category: &apos; &amp; {!category},&apos;&apos;) &amp;
IF(!ISBLANK({!description}), BR()&amp;&apos;Description: &apos; &amp; {!description},&apos;&apos;) &amp;
IF(!ISBLANK({!recordType}), BR()&amp;&apos;Record Type: &apos; &amp; {!recordType},&apos;&apos;) &amp;
IF(!ISBLANK({!type}), BR()&amp;&apos;Type: &apos; &amp; {!type},&apos;&apos;) &amp;
IF(!ISBLANK({!organizationNumber}), &apos; , Organization Name: &apos; &amp; {!organizationName},&apos;&apos;) &amp;
IF(!ISBLANK({!organizationNumber}), BR()&amp;&apos;Organization Number: &apos; &amp; {!organizationNumber},&apos;&apos;) &amp;
IF(!ISBLANK({!sendSeparateEmail} ), BR()&amp;&apos;Send Separate Email: &apos; &amp; {!sendSeparateEmail} ,&apos;&apos;) &amp;
IF(!ISBLANK({!otherParties}), BR()&amp;&apos;Other Parties: &apos; &amp; {!otherParties},&apos;&apos;) &amp;
IF(!ISBLANK({!akaviaOrSacoMember}), BR()&amp;&apos;Akavia or Saco member: &apos; &amp; {!akaviaOrSacoMember},&apos;&apos;) &amp;
IF(!ISBLANK({!origin}), BR()&amp;&apos;Origin: &apos; &amp; {!origin},&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>var_f_OrganizationDescription</name>
        <dataType>String</dataType>
        <expression>&apos;Skickar separat mejl med bifogade filer från e-postadressen ovan: &apos; &amp; 
{!otherParties} &amp;
&apos;Berörs någon som är medlem i Akavia eller annat Sacoförbund: &apos; &amp; 
