    <decisions>
        <description>Reduced FeeCategories must have an end-date.</description>
        <name>CHECK_FeeCat_Missing_End_Date</name>
        <label>CHECK: FeeCat Missing End-Date?</label>
        <locationX>446</locationX>
        <locationY>890</locationY>
        <defaultConnector>
            <targetReference>Create_Upcoming_Full_Fee_Category_After_Reduced_Fee</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_MissingEndDate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GET_Curr_Fee_Category</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GET_Curr_Fee_Category.EndDate__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Set_FeeCatEndDate</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Subflow for Regret Cancellation also returns indicator for current FeeCategory is of Reduced Fee. Needs some special treatment which could be completed in subflow as it is not a screenflow.</description>
        <name>CHECK_Has_reduced_fee</name>
        <label>CHECK: Has reduced fee?</label>
        <locationX>600</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>screenDone</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>False</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>returned_isReducedFee</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GET_Curr_Fee_Category</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Validation_ok</name>
        <label>Validation ok?</label>
        <locationX>627</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>screenInvalid</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_ok</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.MemberCanRegretCancellation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ScreenConfirmRegretExpell</targetReference>
            </connector>
            <label>Yes, ok</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_there_subflow_errors</name>
        <label>Was there subflow errors?</label>
        <locationX>325</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>CHECK_Has_reduced_fee</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, success</defaultConnectorLabel>
        <rules>
            <name>Yes_error</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>subflowErrorMsg</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <connector>
                <targetReference>ScreenError</targetReference>
            </connector>
            <label>Yes, error</label>
        </rules>
    </decisions>
