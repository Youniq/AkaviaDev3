            <label>CloseDate less than 7 days ago</label>
        </rules>
        <rules>
            <name>CloseDate_more_than_7_days_ago</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.ClosedDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>for_D_OneWeekFromNow</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.ClosedDate</leftValueReference>
