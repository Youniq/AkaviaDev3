<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_values_to_Fullbetalande</name>
        <label>Assign values to Fullbetalande</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>Fullbetalande.Membership__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>currFeeCategory.Membership__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Fullbetalande.StartDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>EndDatePlus1</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Fullbetalande.EndDate__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Fullbetalande.MembershipCategory__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Yrkesverksam</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Fullbetalande.FeeCategory__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Fullbetalande</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_new_full_paying</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>CHECK_Create_new_upcoming_FeeCat</name>
        <label>CHECK: Create new upcoming FeeCat?</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_CreateNextFeeCat</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GET_Existing_upcomping_FeeCat</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_values_to_Fullbetalande</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Reducerad</name>
        <label>Reducerad?</label>
        <locationX>380</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YesReducerad</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>currFeeCategory.FeeCategory__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hög reducerad</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>currFeeCategory.FeeCategory__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Låg reducerad</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>currFeeCategory.FeeCategory__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Åter student</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>currFeeCategory.FeeCategory__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Första året</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GET_Existing_upcomping_FeeCat</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Subflow to help in the process of creating upcoming Full Fee (Yrkesverksam) FeeCategory after a reduced fee records planned end-date</description>
    <environments>Default</environments>
    <formulas>
        <name>EndDatePlus1</name>
        <dataType>Date</dataType>
        <expression>{!currFeeCategory.EndDate__c} +1</expression>
    </formulas>
    <interviewLabel>Fee Category - Subflow - Generate Full Fee Category After Reduced Fee {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fee Category - Subflow - Generate Full Fee Category After Reduced Fee</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_new_full_paying</name>
        <label>Create new full paying</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <inputReference>Fullbetalande</inputReference>
    </recordCreates>
    <recordLookups>
        <name>GET_Existing_upcomping_FeeCat</name>
        <label>GET: Existing upcomping FeeCategory</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>CHECK_Create_new_upcoming_FeeCat</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Membership__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>currFeeCategory.Membership__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>currFeeCategory.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Kommande</stringValue>
            </value>
        </filters>
        <filters>
            <field>StartDate__c</field>
            <operator>GreaterThan</operator>
            <value>
                <elementReference>currFeeCategory.StartDate__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>FeeCategory__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Reducerad</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>Input fee category to run process on</description>
        <name>currFeeCategory</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>FeeCategory__c</objectType>
    </variables>
    <variables>
        <name>Fullbetalande</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FeeCategory__c</objectType>
    </variables>
</Flow>
