    <decisions>
        <description>Checks if active assignmnet exist</description>
        <name>CHECK_ActiveAssignment</name>
        <label>Active Assignment exist?</label>
        <locationX>534</locationX>
        <locationY>758</locationY>
        <defaultConnector>
            <targetReference>CHECK_Local4</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesCurrent_CHECK_ActiveAssignment</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>var_sObj_Assignment.StartDate__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_sObj_Assignment.EndDate__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_sObj_Assignment.EndDate__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CHECK_Local1</targetReference>
            </connector>
            <label>Yes, current assignment is active</label>
        </rules>
        <rules>
            <name>YesExisting_CHECK_ActiveAssignment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GET_ActiveAssignment</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>CHECK_Local1</targetReference>
            </connector>
            <label>Yes, existing Assignment is active</label>
        </rules>
    </decisions>
