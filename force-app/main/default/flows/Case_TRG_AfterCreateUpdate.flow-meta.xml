    </decisions>
    <decisions>
        <name>CHECK_Send_Case_Owner_changed_notification</name>
        <label>CHECK: Send Case Owner changed notification</label>
        <locationX>578</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>CHECK_SetCaseSpecifics</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_SendCaseOwnerChangedNotification</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4 AND 5</conditionLogic>
            <conditions>
                <leftValueReference>var_f_CaseIsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>005</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LastModifiedById</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner:User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GET_CustomNotificationType</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>- Case är skapat för ett person account (inte ett employer/workplace account) - För medlemsärende.
- Case är skapat för en förening (föreningsärende)
- Record type = Förhandlings-, Rässhjälps-, Rådgivningsärenden
- Kundcaseorsak = &apos;Medlemsärende&apos; or &apos;Föreningsärende&apos;

Hantera förändrad förening finns med som ett sätt att ta hand om uppdateringar på föreningsfältet på ett case. Tex. om Systemfältet behöver tömmas..</description>
        <name>CHECK_SetCaseSpecifics</name>
        <label>CHECK: Set Case Specifics?</label>
        <locationX>578</locationX>
        <locationY>839</locationY>
        <defaultConnector>
            <targetReference>CHECK_Do_Update_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_SetCaseEmployer</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4 OR 5) AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.IsPersonAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Contact.IsPersonAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>LegalAid</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Negotiation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>LegalCase</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Reason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Medlemsärende</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SET_Case_Employer</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Yes, medlemsärende</label>
        </rules>
        <rules>
            <name>Yes_Foreningsarende</name>
            <conditionLogic>(1 AND (2 OR 3 OR 4) AND 5 AND 6)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Association__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Trustee</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Negotiation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>LegalCase</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Reason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Föreningsärende</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_f_LokalForening</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SET_Case_Lokalf_rening</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Yes, Föreningsärende</label>
        </rules>
        <rules>
            <name>Handle_Changed_Association</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Association__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CHECK_Valid_record_types</targetReference>
            </connector>
            <label>Hantera förändrad förening</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check that the case record type is of a sort which supports having the system parent förening populated.</description>
        <name>CHECK_Valid_record_types</name>
        <label>CHECK: Valid record types?</label>
        <locationX>710</locationX>
        <locationY>947</locationY>
        <defaultConnector>
            <targetReference>Empty_System_Lokalforening</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not valid -&gt; empty system field</defaultConnectorLabel>
        <rules>
            <name>Valid_RTs</name>
            <conditionLogic>(1 OR 2 OR 3) AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>LegalCase</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Negotiation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Trustee</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Association__r.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lokalförening</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Association__r.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lokallokalförening</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>SET_Case_Lokalf_rening</targetReference>
            </connector>
            <label>Valid RTs</label>
        </rules>
    </decisions>
    <description>2025-05-12 - Support for Förhandlingsärende related list on employer acc by popylating asystem field with parent lokalförennig on case.
2025-05-05: Now checks that notification recipient (owner) is active before sending notification
2025-03-17: Now sets Case.Employer__c if conditions are fulfilled
Now doesn&apos;t send notification if I myself set myself as the owner.
Created to send notification to new Case Owner</description>
    <environments>Default</environments>
    <formulas>
        <name>var_f_CaseIsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <description>Returns id of closest related Lokalförening for the input in Association__c field. Only valid if Association is of type Lokallokalförening or Lokalförening. 
Other types returns null</description>
        <name>var_f_LokalForening</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Association__r.Type__c}, &apos;Lokallokalförening&apos;)  &amp;&amp; NOT(ISNULL({!$Record.Association__r.ParentAssociation__c})), 
{!$Record.Association__r.ParentAssociation__c}, 
IF(ISPICKVAL({!$Record.Association__r.Type__c}, &apos;Lokalförening&apos;), {!$Record.Association__c},
null))</expression>
    </formulas>
