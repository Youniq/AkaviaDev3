    <decisions>
        <description>If person account is of type &apos;Förtroendevald, ej Akavia&apos; the account should only get the GDPRStatus__c stamp and then flow ends.</description>
        <name>Check_Account_type</name>
        <label>Check Account type</label>
        <locationX>336</locationX>
        <locationY>398</locationY>
        <defaultConnector>
            <targetReference>Update_person_account2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Is &apos;Förtroendevald, ej Akavia&apos;</defaultConnectorLabel>
        <rules>
            <name>Is_not_F_rtroendevald_ej_Akavia</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Person_Account.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Förtroendevald, ej Akavia</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Invoices_To_delete</targetReference>
            </connector>
            <label>Is not &apos;Förtroendevald, ej Akavia&apos;</label>
        </rules>
    </decisions>
    <decisions>
