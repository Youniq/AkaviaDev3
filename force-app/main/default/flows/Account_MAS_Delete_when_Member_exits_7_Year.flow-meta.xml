            <targetReference>Update_person_account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Invoices To Update</defaultConnectorLabel>
        <rules>
            <name>Yes_Invoices_To_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Invoices_To_delete</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Found_Invoices</targetReference>
            </connector>
            <label>Yes, Invoices To Update</label>
        </rules>
    </decisions>
