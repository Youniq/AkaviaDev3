<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Set section to &quot;Studerandesektionen&quot;</description>
        <name>SET_Set_Section_on_Member</name>
        <label>SET: Set Student Section on Member</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>var_SObj_PersonAccountToUpdate.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_SObj_PersonAccountToUpdate.SystemPersonSection__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Studerandesektionen</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Member</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Inherit section from current employer</description>
        <name>SET_Set_Section_on_Member2</name>
        <label>SET: Set Section on Member</label>
        <locationX>314</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>var_SObj_PersonAccountToUpdate.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_SObj_PersonAccountToUpdate.SystemPersonSection__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.CurrentEmployer__r.Section__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Member</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>CHECK_Member_is_student</name>
        <label>CHECK: Member is student?</label>
        <locationX>182</locationX>
        <locationY>252</locationY>
        <defaultConnector>
            <targetReference>SET_Set_Section_on_Member2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Student</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.MembershipCategory__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Studerande</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SET_Set_Section_on_Member</targetReference>
            </connector>
            <label>Yes Student</label>
        </rules>
    </decisions>
    <description>Flow responsible of correcting the value in field &quot;SystemPersonSection__c&quot;. runs off if the formula field SystemPersonSectionMismatch__c is true.</description>
    <environments>Default</environments>
    <interviewLabel>Account_Scheduled_Correct_Person_Section {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Scheduled - Correct Person Section</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Member</name>
        <label>Update Member</label>
        <locationX>182</locationX>
        <locationY>552</locationY>
        <inputReference>var_SObj_PersonAccountToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CHECK_Member_is_student</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SystemPersonSectionMismatch__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-05-12</startDate>
            <startTime>01:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_SObj_PersonAccountToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
</Flow>
