<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Set
CurrentEmployer__c på person = anställning.arbetsställe.parentId
LatestEmployment__c på person = anställning.Id</description>
        <name>Set_Aktuell_anst_llning</name>
        <label>Set Aktuell anställning</label>
        <locationX>50</locationX>
        <locationY>516</locationY>
        <assignmentItems>
            <assignToReference>Get_Person_Account.CurrentEmployer__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Workplace__r.ParentId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Person_Account.LatestEmployment__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Account</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Set employment relates fields on person account to null.</description>
        <name>Set_person_account_fields</name>
        <label>Null employment on person account</label>
        <locationX>314</locationX>
        <locationY>756</locationY>
        <assignmentItems>
            <assignToReference>Get_Person_Account.LatestEmployment__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Person_Account.CurrentEmployer__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Update_person_account</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>* Update person account with current employment.

* Remove current employment from person account. This case becomes true if the employment has passed its EndDate and the status is no longer Aktiv.</description>
        <name>How_to_update_person_account</name>
        <label>How to update person account</label>
        <locationX>446</locationX>
        <locationY>396</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Aktiv</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Aktuell_anst_llning</targetReference>
            </connector>
            <label>Update with current employment</label>
        </rules>
        <rules>
            <name>Reset_employment_on_person</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Aktiv</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_aktiv_employment</targetReference>
            </connector>
            <label>Reset employment on person</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks so that person acc hasn&apos;t an related active employment. If that happens - the active employment will also go into this flow since updateNeeded__c = true there as well. And that flow run will set the employment fields on person account accordingly.

In the case where no aktiv employment exists for person, flow will continue and remove relations to employment from person account.</description>
        <name>No_aktiv_employment</name>
        <label>Has no aktiv employment?</label>
        <locationX>446</locationX>
        <locationY>636</locationY>
        <defaultConnectorLabel>Yes, found Aktiv employment</defaultConnectorLabel>
        <rules>
            <name>No_Aktiv_Employment_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_aktiv_employment</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_person_account_fields</targetReference>
            </connector>
            <label>No Aktiv employment found</label>
        </rules>
    </decisions>
    <description>Added functionality to null latestEmployment_c and currentEmployer__c on personAcc if the employment in latestEmployment__c isn&apos;t Aktiv</description>
    <interviewLabel>Scheduled Anställning - Update Aktuell anställning on Account Auto {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Employment - Scheduled - Aktuell anställning on Account Auto</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Fetch users employment with status__c = aktiv if there&apos;s one.</description>
        <name>Get_aktiv_employment</name>
        <label>Get aktiv employment (if any)</label>
        <locationX>446</locationX>
        <locationY>516</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>No_aktiv_employment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Person__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Person__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Aktiv</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Employment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Person_Account</name>
        <label>Get Person Account</label>
        <locationX>446</locationX>
        <locationY>276</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>How_to_update_person_account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Person__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Account</name>
        <label>Updaten Person Account</label>
        <locationX>50</locationX>
        <locationY>636</locationY>
        <inputReference>Get_Person_Account</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_person_account</name>
        <label>Update Person Account</label>
        <locationX>314</locationX>
        <locationY>876</locationY>
        <inputReference>Get_Person_Account</inputReference>
    </recordUpdates>
    <start>
        <locationX>320</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Person_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>UpdateNeeded__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Employment__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2020-08-24</startDate>
            <startTime>10:50:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
