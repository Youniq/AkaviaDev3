            <conditions>
                <leftValueReference>$Record.UnemploymentFundThroughAkavia_MC__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.UnemploymentFundThroughAkavia__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IsManager_MC__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.IsManager__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AutoGraduationDate_MC__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.AutoGraduationDate__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EmailConsent_MC__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.EmailConsent__pc</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SMSConsent_MC__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SMSConsent__pc</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StartDateForCurrentFeeCategory_MC__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.StartDateForCurrentFeeCategory__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_MC_Fields</targetReference>
            </connector>
            <label>Update required</label>
        </rules>
    </decisions>

