    <decisions>
        <description>Förmånen ska bara skapas om det inte finns någon aktiv förmån på medlemmen sedan tidigare. Aktiv förmån är medlemsförmån med status Aktiv, Aktiverad eller Skickad till försäkringsbolag. OM det finns Avslutade förmåner så räknas det som att medlemmen saknar medlemsförmånen.</description>
        <name>Decision_1</name>
        <label>DEC does member have SHPO?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
