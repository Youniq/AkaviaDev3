    <decisions>
        <description>&quot;Valid to&quot; is changed to a date before current date</description>
        <name>CHECK_SetToInactive</name>
        <label>Is set to inactive?</label>
        <locationX>1012</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>CHECK_IsActive</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>CHECK_AgreementConnectionSetToInactive_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ValidTo__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ValidTo__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UPDATE_PriorAccountClearCurrentMainAgreement</targetReference>
            </connector>
            <label>Yes</label>
