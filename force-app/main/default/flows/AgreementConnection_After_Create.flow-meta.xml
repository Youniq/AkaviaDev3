        <connector>
            <targetReference>CHECK_OtherActiveMainAgreementConnectionExist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BusinessAccount__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.BusinessAccount__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Aktiv</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsMainAgreement__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AgreementConnection__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
