<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Output_English</name>
        <elementSubtype>AddPromptInstructions</elementSubtype>
        <label>Output English</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Output.Prompt</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>{!Emailtemplate_EN}
</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Output_Svenska</name>
        <elementSubtype>AddPromptInstructions</elementSubtype>
        <label>Output Svenska</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Output.Prompt</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>{!EmailTemplate_SV}
</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Email_language</name>
        <label>Email language</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Svenska</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Input.Language</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Svenska</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Output_Svenska</targetReference>
            </connector>
            <label>Svenska</label>
        </rules>
        <rules>
            <name>English</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Input.Language</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>English</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Output_English</targetReference>
            </connector>
            <label>English</label>
        </rules>
    </decisions>
    <description>Returns the Email draft in the language provided by input</description>
    <environments>Default</environments>
    <interviewLabel>ContractReview - TTPF - Get Email Template {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ContractReview - TTPF - Get Email Template</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>PromptFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <capabilityTypes>
            <name>FlexTemplate://Contract_Review_Email_Draft</name>
            <capabilityName>FlexTemplate://Contract_Review_Email_Draft</capabilityName>
            <inputs>
                <name>Language</name>
                <capabilityInputName>Language</capabilityInputName>
                <dataType>String</dataType>
                <isCollection>false</isCollection>
            </inputs>
            <inputs>
                <name>Contract_Review_Output_Text</name>
                <capabilityInputName>Contract_Review_Output_Text</capabilityInputName>
                <dataType>String</dataType>
                <isCollection>false</isCollection>
            </inputs>
            <inputs>
                <name>Case</name>
                <capabilityInputName>Case</capabilityInputName>
                <dataType>SOBJECT://Case</dataType>
                <isCollection>false</isCollection>
            </inputs>
        </capabilityTypes>
        <connector>
            <targetReference>Email_language</targetReference>
        </connector>
        <triggerType>Capability</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>Emailtemplate_EN</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Hi {!$Input.Case.Account.PreferredFirstName__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;I have reviewed the contract you sent us. My review resulted in the following general notes:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!$Input.Contract_Review_Output_Text}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 10pt; font-family: Arial, sans-serif;&quot;&gt;Regards,&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 10pt; font-family: Arial, sans-serif;&quot;&gt;{!$User.FirstName} {!$User.LastName}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;{!$User.Title}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>EmailTemplate_SV</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Hej {!$Input.Case.Account.PreferredFirstName__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Jag har gått igenom det anställningsavtal som du skickat till oss. Min granskning resulterade översiktligt i följande noteringar:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!$Input.Contract_Review_Output_Text}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 10pt; font-family: Arial, sans-serif;&quot;&gt;Med vänliga hälsningar&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 10pt; font-family: Arial, sans-serif;&quot;&gt;{!$User.FirstName} {!$User.LastName}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;{!$User.Title}&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 10pt; font-family: Arial, sans-serif;&quot;&gt;—&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 10pt; font-family: Arial, sans-serif;&quot;&gt;V / 010 303 75 00&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
</Flow>
