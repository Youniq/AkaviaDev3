        <name>CHECK_TOSC</name>
        <label>What Type Of Service Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>SET_UnknownCategoryError</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unsupported WebCaseCategory</defaultConnectorLabel>
        <rules>
            <name>CHECK_TOSC_SelfEmployed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_P_WebCaseCategory</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SelfEmployed</stringValue>
                </rightValue>
            </conditions>
