    <description>2025-10-25: Now Fetches the most recently created FeeCategory with matching EndDate as Accout CancellationDate. In the event of bad data
2025-10-15: Handle FeeCat &apos;Yrk år 1&apos; according to business rules.
Tagit bort felmeddelande för &quot;Get assignments&quot;, &quot;Get memberbenefits, &quot;Get employments&quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>form_d_lastDayIn3Months</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS(DATE(YEAR(TODAY()), MONTH(TODAY()), 1), 4)-1</expression>
    </formulas>
    <formulas>
        <description>For member returning to FeeCat: Yrk År 1 =&gt; The end-date is set to one year efter graduation date.
First hand use GraduationDate__c, second hand use AutoGraduationDate__c</description>
        <name>form_d_oneYearAfterGraduation</name>
        <dataType>Date</dataType>
        <expression>IF(NOT(ISNULL({!GET_PersonAccount.GraduationDate__c})) , 
(ADDMONTHS({!GET_PersonAccount.GraduationDate__c},12)-1), 
(ADDMONTHS({!GET_PersonAccount.AutoGraduationDate__c},12)-1))</expression>
    </formulas>
    <interviewLabel>Account - Regrett Cancellation {!$Flow.CurrentDateTime}</interviewLabel>
