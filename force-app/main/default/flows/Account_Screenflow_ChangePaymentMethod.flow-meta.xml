    <decisions>
        <name>CHECK_Is_E_Invoice</name>
        <label>CHECK: Is E-Invoice?</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Update_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DistributionMethod_Picker</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>choice_dstrb_efaktura</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SET_E_Invoice_Bank</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>2025-05-27: Now support for  only paper invoice when selecting postal as distribution method. 
2025-05-16: Removed parts where bank fields are wiped, this is now done from Account before save triggered flow instead.</description>
    <dynamicChoiceSets>
        <name>choices_eInvoiceBank</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>EinvoiceBank__c</picklistField>
        <picklistObject>Account</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <description>Needed a formula for occurences where onlyPostalPaperInvoice_checkbox isn&apos;t rendered and therefore is null</description>
        <name>var_f_forcedPaperInvoice</name>
        <dataType>Boolean</dataType>
        <expression>IF({!onlyPostalPaperInvoice_checkbox} == true, true, false)</expression>
    </formulas>
